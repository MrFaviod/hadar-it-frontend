{
  "name": "itms-asset-frontend",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.cjs tests/*.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "python3 tests/react-host.browser.py",
    "test:lifecycle": "python3 tests/host-lifecycle.browser.py",
    "test:visual": "python3 tests/visual-equivalence.browser.py",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.1"
  }
}
